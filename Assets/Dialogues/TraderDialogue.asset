      Effects:
      - Type: 3
        Key: quest.report_marked_cargo
        IntValue: 0
        BoolValue: 0
      - Type: 1
        Key: merchant.report_started
        IntValue: 0
        BoolValue: 1
      - Type: 1
        Key: merchant.resolved
        IntValue: 0
        BoolValue: 1
      Destination:
        Type: 1
        NodeId: reported
    - Id: hub.ignore_origin
      Text: "\u041D\u0435 \u0441\u0442\u0430\u043D\u0443 \u0432 \u044D\u0442\u043E
        \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F. \u041F\u043E\u043A\u0430\u0436\u0438
        \u0442\u043E\u0432\u0430\u0440\u044B."
      Availability:
        AnyOf:
        - AllOf:
          - Type: 3
            Key: merchant.resolved
            ExpectedValue: 0
