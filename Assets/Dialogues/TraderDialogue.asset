        NodeId: reported
    - Id: settlement.defer
      Text: "\u041F\u043E\u043A\u0430 \u043D\u0435 \u0440\u0435\u0448\u0438\u043B."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
  - Id: returned
    Text: "\u0420\u0435\u0433\u0443\u043B\u044F\u0442\u043E\u0440 \u043F\u0435\u0440\u0435\u0434\u0430\u043D
      \u0441\u0431\u043E\u0440\u0449\u0438\u043A\u0443 \u0432\u043E\u0434\u043E\u0441\u0431\u043E\u0440\u043D\u0438\u043A\u0430.
      \u041F\u0443\u0441\u0442\u044C \u0441\u0442\u0430\u0432\u044F\u0442 \u043D\u0430
