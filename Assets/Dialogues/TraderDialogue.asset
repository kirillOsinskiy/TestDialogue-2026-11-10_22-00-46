        NodeId: goodbye
    - Id: hub.check_return
      Text: "\u0427\u0442\u043E \u0441 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043E\u043C
        \u0440\u0435\u0433\u0443\u043B\u044F\u0442\u043E\u0440\u0430?"
      Availability:
        AnyOf:
        - AllOf:
          - Type: 3
            Key: merchant.part_returned
            ExpectedValue: 1
            Comparison: 0
            IntValue: 0
      Effects: []
      Destination:
        Type: 1
        NodeId: returned
    - Id: hub.check_report
      Text: "\u041E \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435\u2026"
      Availability:
        AnyOf:
        - AllOf:
          - Type: 3
            Key: merchant.report_started
            ExpectedValue: 1
            Comparison: 0
            IntValue: 0
      Effects: []
      Destination:
        Type: 1
        NodeId: merchant_reported
    - Id: hub.leave
      Text: "\u042F \u0435\u0449\u0451 \u043F\u043E\u0434\u0443\u043C\u0430\u044E.
        \u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: goodbye
  - Id: settlement
    Text: "\u041B\u0430\u0434\u043D\u043E. \u041E\u0442\u0434\u0430\u043C \u0440\u0435\u0433\u0443\u043B\u044F\u0442\u043E\u0440
      \u043E\u0431\u0449\u0438\u043D\u0435, \u0447\u0435\u0440\u0435\u0437 \u0438\u0445
      \u0441\u0431\u043E\u0440\u0449\u0438\u043A\u0430. \u041F\u043E\u0442\u0435\u0440\u044F\u044E
      \u0442\u043E, \u0447\u0442\u043E \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A\u0443, \u0437\u0430\u0442\u043E
      \u0431\u0435\u0437 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E\u0433\u043E
      \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F. \u0422\u0430\u043A
      \u0437\u0430\u043A\u0440\u043E\u0435\u043C \u0432\u043E\u043F\u0440\u043E\u0441?"
    Choices:
    - Id: settlement.accept_return
      Text: "\u0414\u0430. \u0412\u0435\u0440\u043D\u0438 \u0434\u0435\u0442\u0430\u043B\u044C
        \u2014 \u043D\u0430 \u044D\u0442\u043E\u043C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043C."
      Availability:
        AnyOf:
        - AllOf:
          - Type: 3
            Key: merchant.resolved
            ExpectedValue: 0
            Comparison: 0
            IntValue: 0
          - Type: 2
            Key: info.merchant_manifest
            ExpectedValue: 1
            Comparison: 0
            IntValue: 0
      Effects:
