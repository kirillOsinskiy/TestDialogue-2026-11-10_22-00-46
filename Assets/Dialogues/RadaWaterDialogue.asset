  m_Name: RadaWaterDialogue
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueAsset
  Id: rada_water
  DisplayName: "\u0412\u043E\u0434\u0430 \u0434\u043B\u044F \u043E\u0431\u0449\u0438\u043D\u044B"
  SpeakerName: "\u0420\u0430\u0434\u0430"
  EntryNodeId: greeting
  Nodes:
  - Id: greeting
    Text: "\u0417\u0430 \u0432\u043E\u0434\u043E\u0439? \u041F\u043E\u043A\u0430
      \u0432\u044B\u0434\u0430\u0451\u043C \u043F\u043E \u043A\u0440\u0443\u0436\u043A\u0435.
      \u0424\u0438\u043B\u044C\u0442\u0440 \u0441\u043E \u0441\u043C\u0435\u043D\u044B
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438."
    Choices:
    - Id: rada.ask_problem
      Text: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
        \u0441 \u0444\u0438\u043B\u044C\u0442\u0440\u043E\u043C?"
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: problem
    - Id: rada.open_questions
      Text: "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441\u044B."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
    - Id: rada.ask_trade
      Text: "\u041D\u0443\u0436\u043D\u044B \u043F\u0440\u0438\u043F\u0430\u0441\u044B."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: trade
    - Id: rada.leave_greeting
      Text: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: goodbye
  - Id: problem
    Text: "\u0411\u0435\u0437 \u0444\u0438\u043B\u044C\u0442\u0440\u0430 \u0432\u043E\u0434\u043E\u0441\u0431\u043E\u0440\u043D\u0438\u043A
      \u0433\u043E\u043D\u0438\u0442 \u0440\u0436\u0430\u0432\u0443\u044E \u0432\u0437\u0432\u0435\u0441\u044C.
      \u0414\u043E \u0437\u0430\u0432\u0442\u0440\u0430 \u043F\u0440\u043E\u0442\u044F\u043D\u0435\u043C,
      \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0440\u0430\u0437\u0434\u0430\u0447\u0443."
    Choices:
    - Id: rada.promise_help
      Text: "\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u043D\u0430\u0439\u0442\u0438
        \u0444\u0438\u043B\u044C\u0442\u0440."
      Availability:
        AnyOf:
        - AllOf:
          - Type: 0
            Key: rada.promise_help
            ExpectedValue: 0
            Comparison: 0
            IntValue: 0
      Effects:
      - Type: 0
        Key: water_community
        IntValue: 1
        BoolValue: 0
      Destination:
        Type: 1
        NodeId: promise
    - Id: rada.no_promise
      Text: "\u041F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
        \u043E\u0431\u0435\u0449\u0430\u044E."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
  - Id: promise
    Text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u042F \u0437\u0430\u043F\u043E\u043C\u043D\u044E,
      \u0447\u0442\u043E \u0442\u044B \u0432\u044B\u0437\u0432\u0430\u043B\u0441\u044F
      \u043F\u043E\u043C\u043E\u0447\u044C. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0439, \u043A\u0430\u043A
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A."
    Choices:
    - Id: rada.promise_continue
      Text: "\u0414\u0430\u0432\u0430\u0439 \u043E\u0431\u0441\u0443\u0434\u0438\u043C
        \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0438."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
  - Id: hub
    Text: "\u0427\u0442\u043E \u0435\u0449\u0451 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0443\u0437\u043D\u0430\u0442\u044C?"
    Choices:
    - Id: rada.ask_problem_again
      Text: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u0444\u0438\u043B\u044C\u0442\u0440\u0435."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: problem
    - Id: rada.ask_lead
      Text: "\u042F \u043E\u0431\u0435\u0449\u0430\u043B \u043F\u043E\u043C\u043E\u0447\u044C.
        \u0415\u0441\u0442\u044C \u0437\u0430\u0446\u0435\u043F\u043A\u0438?"
      Availability:
        AnyOf:
        - AllOf:
          - Type: 0
            Key: rada.promise_help
            ExpectedValue: 1
            Comparison: 0
            IntValue: 0
          - Type: 2
            Key: info.filter_location
            ExpectedValue: 0
            Comparison: 0
            IntValue: 0
      Effects: []
      Destination:
        Type: 1
        NodeId: lead
    - Id: rada.offer_delegation
      Text: "\u042F \u0437\u043D\u0430\u044E, \u0433\u0434\u0435 \u0444\u0438\u043B\u044C\u0442\u0440.
        \u041C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
        \u0441\u0432\u043E\u0438\u0445 \u043B\u044E\u0434\u0435\u0439?"
      Availability:
        AnyOf:
        - AllOf:
          - Type: 1
            Key: water_community
            ExpectedValue: 0
            Comparison: 3
            IntValue: 1
          - Type: 2
            Key: info.filter_location
            ExpectedValue: 1
            Comparison: 3
            IntValue: 1
          - Type: 3
            Key: water.plan_chosen
            ExpectedValue: 0
            Comparison: 3
            IntValue: 1
      Effects: []
      Destination:
        Type: 1
        NodeId: delegation
    - Id: rada.offer_search
      Text: "\u0424\u0438\u043B\u044C\u0442\u0440 \u0443 \u0441\u0442\u0430\u0440\u043E\u0439
        \u043D\u0430\u0441\u043E\u0441\u043D\u043E\u0439. \u042F \u043F\u0440\u0438\u043D\u0435\u0441\u0443
        \u0435\u0433\u043E."
      Availability:
        AnyOf:
        - AllOf:
          - Type: 2
            Key: info.filter_location
            ExpectedValue: 1
            Comparison: 0
            IntValue: 0
          - Type: 3
            Key: water.plan_chosen
            ExpectedValue: 0
            Comparison: 0
            IntValue: 0
      Effects: []
      Destination:
        Type: 1
        NodeId: assignment
    - Id: rada.ask_progress
      Text: "\u041E \u043F\u043E\u0438\u0441\u043A\u0435 \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u2026"
      Availability:
        AnyOf:
        - AllOf:
          - Type: 3
            Key: water.search_started
            ExpectedValue: 1
            Comparison: 0
            IntValue: 0
      Effects: []
      Destination:
        Type: 1
        NodeId: progress
    - Id: rada.check_delegation
      Text: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u0430\u0448\u0438 \u043B\u044E\u0434\u0438
        \u0437\u0430\u0439\u043C\u0443\u0442\u0441\u044F \u043F\u043E\u0438\u0441\u043A\u043E\u043C?"
      Availability:
        AnyOf:
        - AllOf:
          - Type: 3
            Key: water.community_search_started
            ExpectedValue: 1
            Comparison: 0
            IntValue: 0
      Effects: []
      Destination:
        Type: 1
        NodeId: delegation
    - Id: rada.trade_from_hub
      Text: "\u041F\u043E\u043A\u0430\u0436\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: trade
    - Id: rada.leave_hub
      Text: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: goodbye
  - Id: lead
    Text: "\u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u044F\u0449\u0438\u043A \u0443 \u0441\u0442\u0430\u0440\u043E\u0439 \u043D\u0430\u0441\u043E\u0441\u043D\u043E\u0439.
      \u0418\u0449\u0438 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0443\u044E \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0443\u044E
      \u043F\u043E\u043B\u043E\u0441\u0443 \u043D\u0430 \u043A\u0440\u044B\u0448\u043A\u0435."
    Choices:
    - Id: rada.remember_location
      Text: "\u0421\u0442\u0430\u0440\u0430\u044F \u043D\u0430\u0441\u043E\u0441\u043D\u0430\u044F,
        \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u0430.
        \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u043B."
      Availability:
        AnyOf: []
      Effects:
      - Type: 2
        Key: info.filter_location
        IntValue: 0
        BoolValue: 0
      Destination:
        Type: 1
        NodeId: hub
  - Id: trust
    Text: "\u0422\u0435\u0431\u0435 \u0437\u0434\u0435\u0441\u044C \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442.
      \u0415\u0441\u043B\u0438 \u043D\u0430\u0439\u0434\u0451\u0448\u044C \u0444\u0438\u043B\u044C\u0442\u0440,
      \u043D\u0435\u0441\u0438 \u043F\u0440\u044F\u043C\u043E \u043A\u043E \u043C\u043D\u0435.
      \u042F \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0443 \u043B\u044E\u0434\u0435\u0439
      \u0443 \u0432\u043E\u0440\u043E\u0442."
    Choices:
    - Id: rada.trust_continue
      Text: "\u041F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043D\u0435
        \u043F\u043E\u0434\u0432\u0435\u0441\u0442\u0438."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
  - Id: assignment
    Text: "\u041F\u0440\u043E\u0432\u0435\u0440\u044C \u0441\u0442\u0430\u0440\u0443\u044E
      \u043D\u0430\u0441\u043E\u0441\u043D\u0443\u044E \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0438
      \u0444\u0438\u043B\u044C\u0442\u0440. \u042F \u0437\u0430\u043F\u0438\u0448\u0443,
      \u0447\u0442\u043E \u043F\u043E\u0438\u0441\u043A\u043E\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F
      \u0442\u044B."
    Choices:
    - Id: rada.accept_quest
      Text: "\u0411\u0435\u0440\u0443\u0441\u044C \u0437\u0430 \u043F\u043E\u0438\u0441\u043A."
      Availability:
        AnyOf:
        - AllOf:
          - Type: 3
            Key: water.plan_chosen
            ExpectedValue: 0
            Comparison: 0
            IntValue: 0
      Effects:
      - Type: 3
        Key: quest.find_filter
        IntValue: 0
        BoolValue: 0
      - Type: 1
        Key: water.search_started
        IntValue: 0
        BoolValue: 1
      - Type: 1
        Key: water.plan_chosen
        IntValue: 0
        BoolValue: 1
      Destination:
        Type: 1
        NodeId: hub
    - Id: rada.defer_quest
      Text: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
  - Id: progress
    Text: "\u041F\u043E\u043A\u0430 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439
      \u043D\u0435\u0442? \u041B\u0430\u0434\u043D\u043E. \u041C\u044B \u0435\u0449\u0451
      \u043F\u043E\u0442\u044F\u043D\u0435\u043C, \u043D\u043E \u043B\u0443\u0447\u0448\u0435
      \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
    Choices:
    - Id: rada.progress_continue
      Text: "\u0415\u0449\u0451 \u0438\u0449\u0443."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
  - Id: trade
    Text: "\u0415\u0441\u0442\u044C \u0441\u0443\u0445\u0430\u0440\u0438, \u0442\u043A\u0430\u043D\u044C
      \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043A\u0440\u0435\u043F\u0435\u0436\u0430.
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u0447\u0442\u043E \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435."
    Choices:
    - Id: rada.open_trade
      Text: "\u041F\u043E\u043A\u0430\u0436\u0438 \u0442\u043E\u0432\u0430\u0440\u044B."
      Availability:
        AnyOf: []
      Effects:
      - Type: 4
        Key: trade
        IntValue: 0
        BoolValue: 0
      Destination:
        Type: 1
        NodeId: hub
    - Id: rada.skip_trade
      Text: "\u0412 \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0437."
      Availability:
        AnyOf: []
      Effects: []
      Destination:
        Type: 1
        NodeId: hub
  - Id: goodbye
    Text: "\u0411\u0435\u0440\u0435\u0433\u0438 \u0432\u043E\u0434\u0443. \u0418
      \u0441\u0435\u0431\u044F \u0442\u043E\u0436\u0435."
    Choices: []
  - Id: delegation
    Text: "\u041C\u043E\u0433\u0443 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
      \u0434\u0432\u043E\u0438\u0445 \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430
      \u0443 \u0441\u0442\u0430\u0440\u043E\u0439 \u043D\u0430\u0441\u043E\u0441\u043D\u043E\u0439.
      \u0415\u0441\u043B\u0438 \u043C\u044B \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u2014 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E \u0438\u0445,
      \u0430 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
      \u0441\u0432\u043E\u0438\u043C\u0438 \u0434\u0435\u043B\u0430\u043C\u0438."
    Choices:
    - Id: rada.confirm_delegation
      Text: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C.
        \u0418\u0449\u0438\u0442\u0435 \u044F\u0449\u0438\u043A \u0441 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0439
        \u043F\u043E\u043B\u043E\u0441\u043E\u0439."
      Availability:
